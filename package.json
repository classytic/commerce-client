{
  "name": "@classytic/commerce-client",
  "version": "0.3.0",
  "description": "Typed storefront and merchant clients for the Classytic Commerce API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./management": {
      "types": "./dist/management.d.ts",
      "default": "./dist/management.js"
    },
    "./management/types": {
      "types": "./dist/management-types.d.ts",
      "default": "./dist/management-types.js"
    },
    "./delivery-types": {
      "types": "./dist/delivery-types.d.ts",
      "default": "./dist/delivery-types.js"
    },
    "./category-tree": {
      "types": "./dist/category-tree.d.ts",
      "default": "./dist/category-tree.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "management.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "push": "classytic-push",
    "release:tag": "node -e \"require('child_process').execSync('npm run push -- v'+require('./package.json').version,{stdio:'inherit'})\"",
    "release": "npm run push -- main && npm run release:tag && npm publish"
  },
  "dependencies": {
    "@classytic/arc-next": "^0.18.0",
    "@classytic/media-transform": "^0.3.0",
    "@classytic/primitives": "^0.34.0"
  },
  "devDependencies": {
    "@classytic/dev-tools": "^0.2.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "7.1.0-beta",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/classytic/commerce-client.git"
  },
  "bugs": {
    "url": "https://github.com/classytic/commerce-client/issues"
  },
  "homepage": "https://github.com/classytic/commerce-client#readme"
}
